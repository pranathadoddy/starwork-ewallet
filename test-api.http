  "email": "newadmin@example.com",
  "password": "admin123",
  "firstName": "New",
  "lastName": "Admin"
}

### Test Logout
POST http://localhost:3000/auth/logout
Authorization: Bearer YOUR_JWT_TOKEN_HERE

