{
	"info": {
		"_postman_id": "ewallet-api-collection",
		"name": "E-Wallet API",
		"description": "Complete API collection for the E-Wallet system with user management, authentication, deposits, transfers, and payments",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"users",
								"register"
							]
						},
						"description": "Register a new user account"
					},
					"response": []
				},
				{
					"name": "Create Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/create-admin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"create-admin"
							]
						},
						"description": "Create an admin user (only works if no admin exists)"
					},
					"response": []
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login and get JWT token"
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"logout"
							]
						},
						"description": "Logout and invalidate current session"
					},
					"response": []
				},
				{
					"name": "Logout All Sessions",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/logout-all",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"logout-all"
							]
						},
						"description": "Logout from all active sessions"
					},
					"response": []
				},
				{
					"name": "Get Active Sessions",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/sessions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"sessions"
							]
						},
						"description": "Get all active sessions for the current user"
					},
					"response": []
				}
			],
			"description": "Authentication and user management endpoints"
		},
		{
			"name": "Deposits",
			"item": [
				{
					"name": "Request Deposit",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 100.00,\n  \"description\": \"Initial deposit\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/deposits/request",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"deposits",
								"request"
							]
						},
						"description": "Request a deposit (USER role required)"
					},
					"response": []
				},
				{
					"name": "Get Pending Deposits (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/deposits/pending",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"deposits",
								"pending"
							]
						},
						"description": "Get all pending deposits (ADMIN role required)"
					},
					"response": []
				},
				{
					"name": "Approve Deposit",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"depositId\": \"{{deposit_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/deposits/approve",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"deposits",
								"approve"
							]
						},
						"description": "Approve a pending deposit (ADMIN role required)"
					},
					"response": []
				},
				{
					"name": "Get User Deposits",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/deposits/my-deposits",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"deposits",
								"my-deposits"
							]
						},
						"description": "Get all deposits for the current user"
					},
					"response": []
				}
			],
			"description": "Deposit management endpoints"
		},
