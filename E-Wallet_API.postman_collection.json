					},
					"response": []
				},
				{
					"name": "Get Transaction History",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/wallet/transactions?page=1&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"wallet",
								"transactions"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Get transaction history with pagination"
					},
					"response": []
				}
			],
			"description": "Wallet operations and transaction management"
